<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wms.warehouse.mapper.WmsPointMapper">

    <resultMap id="WmsPointVOResultMap" type="com.wms.warehouse.model.vo.WmsPointVO">
        <id property="id" column="id"/>
        <result property="plantCode" column="plant_code"/>
        <result property="locationId" column="location_id"/>
        <result property="locationCode" column="location_code"/>
        <result property="locationName" column="location_name"/>
        <result property="aisleId" column="aisle_id"/>
        <result property="aisleCode" column="aisle_code"/>
        <result property="aisleName" column="aisle_name"/>
        <result property="pointCode" column="point_code"/>
        <result property="pointName" column="point_name"/>
        <result property="barcode" column="barcode"/>
        <result property="coordinate" column="coordinate"/>
        <result property="floor" column="floor"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="status" column="status"/>
        <result property="remark" column="remark"/>
        <result property="createdByName" column="created_by_name"/>
        <result property="createdTime" column="created_time"/>
        <result property="updatedByName" column="updated_by_name"/>
        <result property="updatedTime" column="updated_time"/>
    </resultMap>

    <select id="getWmsPointPage" resultMap="WmsPointVOResultMap">
        SELECT
            p.id,
            p.plant_code,
            p.location_id,
            l.location_code,
            l.location_name,
            p.aisle_id,
            a.aisle_code,
            a.aisle_name,
            p.point_code,
            p.point_name,
            p.barcode,
            p.coordinate,
            p.floor,
            p.sort_order,
            p.status,
            p.remark,
            su1.nickname AS created_by_name,
            p.created_time,
            su2.nickname AS updated_by_name,
            p.updated_time
        FROM wms_point p
        LEFT JOIN wms_location l ON p.location_id = l.id
        LEFT JOIN wms_aisle a ON p.aisle_id = a.id
        LEFT JOIN sys_user su1 ON p.created_by = su1.id
        LEFT JOIN sys_user su2 ON p.updated_by = su2.id
        <where>
            <if test="queryParams.status != null">
                AND p.status = #{queryParams.status}
            </if>
            <if test="queryParams.plantCode != null and queryParams.plantCode != ''">
                AND p.plant_code LIKE '%' || #{queryParams.plantCode} || '%'
            </if>
            <if test="queryParams.floor != null and queryParams.floor != ''">
                AND p.floor LIKE '%' || #{queryParams.floor} || '%'
            </if>
            <if test="queryParams.pointCode != null and queryParams.pointCode != ''">
                AND p.point_code LIKE '%' || #{queryParams.pointCode} || '%'
            </if>
            <if test="queryParams.pointName != null and queryParams.pointName != ''">
                AND p.point_name LIKE '%' || #{queryParams.pointName} || '%'
            </if>
            <if test="queryParams.barcode != null and queryParams.barcode != ''">
                AND p.barcode LIKE '%' || #{queryParams.barcode} || '%'
            </if>
            <if test="queryParams.coordinate != null and queryParams.coordinate != ''">
                AND p.coordinate LIKE '%' || #{queryParams.coordinate} || '%'
            </if>
            <if test="queryParams.aisleId != null">
                AND p.aisle_id = #{queryParams.aisleId}
            </if>
            <if test="queryParams.locationCode != null and queryParams.locationCode != ''">
                AND l.location_code LIKE '%' || #{queryParams.locationCode} || '%'
            </if>
            <if test="queryParams.locationId != null">
                AND p.location_id = #{queryParams.locationId}
            </if>
            <if test="queryParams.aisleCode != null and queryParams.aisleCode != ''">
                AND a.aisle_code LIKE '%' || #{queryParams.aisleCode} || '%'
            </if>
        </where>
        ORDER BY p.sort_order ASC, p.id ASC
    </select>

</mapper>