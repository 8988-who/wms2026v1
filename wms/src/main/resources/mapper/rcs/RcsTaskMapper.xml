<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wms.rcs.mapper.RcsTaskMapper">

    <resultMap id="RcsTaskVOResultMap" type="com.wms.rcs.model.vo.RcsTaskVO">
        <id property="id" column="id"/>
        <result property="taskCode" column="task_code"/>
        <result property="taskType" column="task_type"/>
        <result property="taskTitle" column="task_title"/>
        <result property="fromLocation" column="from_location"/>
        <result property="toLocation" column="to_location"/>
        <result property="cartCode" column="cart_code"/>
        <result property="payload" column="payload"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result property="status" column="status"/>
        <result property="priority" column="priority"/>
        <result property="agvCode" column="agv_code"/>
        <result property="rcsTaskId" column="rcs_task_id"/>
        <result property="submitTime" column="submit_time"/>
        <result property="assignedAt" column="assigned_at"/>
        <result property="startTime" column="start_time"/>
        <result property="finishTime" column="finish_time"/>
        <result property="errorMsg" column="error_msg"/>
        <result property="remark" column="remark"/>
        <result property="createdByName" column="created_by_name"/>
        <result property="createdTime" column="created_time"/>
        <result property="updatedByName" column="updated_by_name"/>
        <result property="updatedTime" column="updated_time"/>
    </resultMap>

    <select id="getRcsTaskPage" resultMap="RcsTaskVOResultMap">
        SELECT
            t.id,
            t.task_code,
            t.task_type,
            t.task_title,
            t.from_location,
            t.to_location,
            t.cart_code,
            t.payload,
            t.status,
            t.priority,
            t.agv_code,
            t.rcs_task_id,
            t.submit_time,
            t.assigned_at,
            t.start_time,
            t.finish_time,
            t.error_msg,
            t.remark,
            su1.nickname AS created_by_name,
            t.created_time,
            su2.nickname AS updated_by_name,
            t.updated_time
        FROM wms_rcs_task t
        LEFT JOIN sys_user su1 ON t.created_by = su1.id
        LEFT JOIN sys_user su2 ON t.updated_by = su2.id
        <where>
            <if test="queryParams.taskCode != null and queryParams.taskCode != ''">
                AND t.task_code LIKE '%' || #{queryParams.taskCode} || '%'
            </if>
            <if test="queryParams.taskType != null">
                AND t.task_type = #{queryParams.taskType}
            </if>
            <if test="queryParams.status != null">
                AND t.status = #{queryParams.status}
            </if>
            <if test="queryParams.priority != null">
                AND t.priority = #{queryParams.priority}
            </if>
            <if test="queryParams.agvCode != null and queryParams.agvCode != ''">
                AND t.agv_code LIKE '%' || #{queryParams.agvCode} || '%'
            </if>
            <if test="queryParams.cartCode != null and queryParams.cartCode != ''">
                AND t.cart_code LIKE '%' || #{queryParams.cartCode} || '%'
            </if>
            <if test="queryParams.submitTimeStart != null">
                AND t.submit_time &gt;= #{queryParams.submitTimeStart}
            </if>
            <if test="queryParams.submitTimeEnd != null">
                AND t.submit_time &lt;= #{queryParams.submitTimeEnd}
            </if>
        </where>
        ORDER BY t.submit_time DESC NULLS LAST, t.id DESC
    </select>

</mapper>
