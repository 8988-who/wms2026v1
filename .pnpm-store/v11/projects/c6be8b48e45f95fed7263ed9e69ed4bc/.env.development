# 应用端口（5173：避开系统保留端口区间 2967-3166，原 3000 会被 Hyper-V/WSL 保留导致 EACCES）
VITE_APP_PORT=5173
# 项目名称
VITE_APP_TITLE=wms系统
# 代理前缀
VITE_APP_BASE_API=/dev-api

# 接口地址
# VITE_APP_API_URL=https://api.wms.com     # 线上
# VITE_APP_API_URL=https://api.wms.com/v2    # 线上(多租户)
VITE_APP_API_URL=http://localhost:8000       # 本地后端（后端实际监听localhost:8000）


# 启用 Mock 服务(true:开启 false:关闭)
VITE_MOCK_DEV_SERVER=false

# 多租户开关(true:开启 false:关闭)
VITE_APP_TENANT_ENABLED=false
